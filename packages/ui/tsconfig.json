{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // For the shadcn-vue CLI / editor only. Vendored components import via
    // relative paths (not @/) so they resolve when consumed as source.
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"]
  },
  // Template checks off by default in vue-tsc: an unimported component, an undeclared event or an
  // unknown directive otherwise only shows up as a Vue warning at runtime.
  "vueCompilerOptions": {
    "checkUnknownComponents": true,
    "checkUnknownEvents": true,
    "checkUnknownDirectives": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "playwright/**/*.ts", "tests/**/*.ts", "*.config.ts"]
}
