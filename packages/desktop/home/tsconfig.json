{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node", "vite/client"]
  },
  // Same template checks as web/ui: an unimported component, an undeclared event or an unknown
  // directive otherwise only shows up as a Vue warning at runtime.
  "vueCompilerOptions": {
    "checkUnknownComponents": true,
    "checkUnknownEvents": true,
    "checkUnknownDirectives": true
  },
  // bridge.ts declares window.kinora, the IPC surface the home UI calls.
  "include": ["src/**/*.ts", "src/**/*.vue", "../src/bridge.ts", "vite.config.ts"]
}
